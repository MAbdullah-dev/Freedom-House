<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="lms_testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="STRIPE_KEY" value="" force="true"/>
        <env name="STRIPE_SECRET" value="" force="true"/>
        <env name="AZURE_CLIENT_ID" value="" force="true"/>
        <env name="AZURE_CLIENT_SECRET" value="" force="true"/>
        <env name="AZURE_TENANT_ID" value="" force="true"/>
        <env name="AZURE_REDIRECT_URI" value="" force="true"/>
        <env name="VIMEO_CLIENT" value="" force="true"/>
        <env name="VIMEO_SECRET" value="" force="true"/>
        <env name="VIMEO_ACCESS" value="" force="true"/>
        <env name="VIMEO_CLIENT_ID" value="" force="true"/>
        <env name="VIMEO_CLIENT_SECRET" value="" force="true"/>
        <env name="VIMEO_ACCESS_TOKEN" value="" force="true"/>
        <env name="AWS_ACCESS_KEY_ID" value="" force="true"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="" force="true"/>
    </php>
</phpunit>
